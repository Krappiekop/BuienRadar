@page
@model IndexModel
@{
    ViewData["Title"] = "Home page";
}


@if (Model.Data.Actual.StationMeasurements != null){
<p>Aantal actuele stations: @Model.Data.Actual.StationMeasurements.Count</p>
}
else
{
    <p>Gegevens worden geladen of zijn niet beschikbaar...</p>
}

@foreach (var x in Model.Data.Actual.StationMeasurements)
{
    <ul>
        <li>@x.StationName</li>
        <li>@x.Regio</li>
        <li>@x.Temperature</li>
        <li>@x.FeelTemperature</li>
        <li>@x.GroundTemperature</li>
        <li>@x.SunPower</li>
        <li>@x.RainFallLastHour</li>
        <li>@x.WindDirection</li>
    </ul>
}